8:["$","section",null,{"className":"booking","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"Booking · parcerias · imprensa"}],["$","h2",null,{"children":["Vamos levar ",["$","em",null,{"children":"brasilidade"}],["$","br",null,{}]," ao seu evento?"]}]]}],["$","div",null,{"children":[["$","p",null,{"children":"Para contratações, parcerias ou imprensa, entre em contato através dos canais oficiais. Nossa equipe retornará o mais breve possível."}],["$","a",null,{"className":"text-link light","href":"mailto:contato@nellvasantana.com","children":["contato@nellvasantana.com ",["$","span",null,{"children":"↗"}]]}]]}]]}]
